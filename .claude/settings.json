{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python main_ai.py:*)",
      "Bash(python src/test_modern_reports.py)",
      "Bash(python audit_docx_structure.py:*)",
      "Bash(pip install -r:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(config.yaml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.sh"
          }
        ]
      }
    ]
  }
}
